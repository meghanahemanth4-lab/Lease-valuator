#!/bin/sh

# Black        0;30     Dark Gray     1;30
# Red          0;31     Light Red     1;31
# Green        0;32     Light Green   1;32
# Brown/Orange 0;33     Yellow        1;33
# Blue         0;34     Light Blue    1;34
# Purple       0;35     Light Purple  1;35
# Cyan         0;36     Light Cyan    1;36
# Light Gray   0;37     White         1;37

# RED='\033[0;31m'
# NC='\033[0m' # No Color

# Regular expression for matching Jira issue numbers
JIRA_REGEX="([A-Z][A-Z0-9_]{1,10})+-[0-9]*"
# Get the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[1;36m'
NC='\033[0m'
BOLD=$(tput bold)
NORM=$(tput sgr0)

# Check if the branch name matches the Jira issue number pattern
if [[ $BRANCH_NAME =~ $JIRA_REGEX ]]; then

    # Get the Jira issue number from the branch name
    JIRA_ISSUE_NUMBER=${BASH_REMATCH[0]}

    # Get the commit message from the commit message file
    COMMIT_MESSAGE=$(cat "$1")
    COMMIT_MESSAGE_SIZE=${#COMMIT_MESSAGE}

    # Check if the commit message starts with the Jira issue number
    if [[ ! $COMMIT_MESSAGE =~ ^$JIRA_ISSUE_NUMBER ]]; then

        # Print an error message and exit with a non-zero exit code to abort the commit
        echo ""
        echo -e "[${RED}COMMIT-POLICY${NC}]: Commit message must start with the JIRA issue number. Example --> ${CYAN}$JIRA_ISSUE_NUMBER"
        echo ""
        echo -e "${CYAN}-----------------------------------------------------${NC}"
        echo -e "Git Commit Message Pattern: ${YELLOW}${BOLD}JIRA-123${NORM}: ${CYAN}COMMIT_MESSAGE${NC}"
        echo -e "${CYAN}-----------------------------------------------------${NC}"
        echo ""
        exit 1
    elif [[ $COMMIT_MESSAGE_SIZE -lt 40 ]]; then

        # Print an error message and exit with a non-zero exit code to abort the commit
        echo ""
        echo -e "[${RED}COMMIT-POLICY${NC}]: Commit message must be at least 40 character long"
        echo ""
        exit 1
    fi
else
    echo ""
    echo -e "[${RED}COMMIT-POLICY${NC}]"
    echo -e "Branch Name must have a JIRA issue number: ${CYAN}$BRANCH_NAME"
    echo ""
    exit 1
fi

# Exit with a zero exit code to allow the commit to proceed
exit 0