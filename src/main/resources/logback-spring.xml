<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
    <springProperty name="username" source="logging.loki.username"/>
    <springProperty name="password" source="logging.loki.password"/>
    <!-- Define properties for log file locations -->
    <property name="lva-service" value="lva-service-${LOKI_LOG_ENV}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>lease-valuator-service</serviceName>
            <includeMarkers>true</includeMarkers>
            <includeOrigin>true</includeOrigin>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.LokiAppender">
        <http>
            <url>https://loki.spiroiothub.com/loki/api/v1/push</url>
<!--            <user>${username}</user>-->
<!--            <password>${password}</password>-->
        </http>
        <format>
            <label>
                <pattern>
                    job="lva-service",env="${LOKI_LOG_ENV}"
                </pattern>
            </label>
            <messagePattern>%msg</messagePattern>
        </format>
    </appender>

